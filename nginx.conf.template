server {
    listen ${LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Images travel as base64 JSON; a large PNG for upscaling or editing can exceed 50 MB.
    client_max_body_size 200m;

    location /api/ {
        proxy_pass ${OLLAMA_URL};
        proxy_http_version 1.1;
        # Ollama rejects requests whose Origin/Host it doesn't recognise,
        # so present the request as coming from Ollama's own host.
        proxy_set_header Host localhost;
        proxy_set_header Origin "";

        # Stream tokens straight through instead of buffering the response.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # stable-diffusion.cpp image server (native async job API).
    location /sdcpp/ {
        proxy_pass ${SD_URL};
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Second stable-diffusion.cpp server for image editing; the prefix is
    # stripped so it sees the same /sdcpp/v1/... paths.
    location /sdcpp-edit/ {
        proxy_pass ${SD_EDIT_URL}/;
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Third stable-diffusion.cpp server for video generation, prefix stripped likewise.
    location /sdcpp-video/ {
        proxy_pass ${SD_VIDEO_URL}/;
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Fourth stable-diffusion.cpp server (Wan video), prefix stripped likewise.
    location /sdcpp-wan/ {
        proxy_pass ${SD_WAN_URL}/;
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
